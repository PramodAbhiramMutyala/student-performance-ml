# Application Settings
APP_NAME="Student Performance Prediction and Academic Risk Analysis"
APP_ENV="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=5242880  # 5 MB
MAX_BATCH_ROWS=5000

# Database
DATABASE_URL="sqlite:///./data/predictions.db"

# Model Risk Thresholds (Portuguese secondary 0-20 scale)
HIGH_RISK_THRESHOLD=10.0   # Score < 10 indicates High Risk / Failing
MEDIUM_RISK_THRESHOLD=14.0 # Score 10 to < 14 indicates Moderate Risk / Satisfactory
# Score >= 14 indicates Low Risk / Good to Excellent
